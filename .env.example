# Optional overrides for the Docker Compose stack. Copy this file to .env to use it.
#
# The stack's credentials are made-up local-only values in the shared compose file
# (shared-compose/compose.yml in digital-waste-tracking-uat), so none are needed here.

# Use a local checkout of the shared compose file, to try changes to it
# SHARED_COMPOSE=../digital-waste-tracking-uat/shared-compose/compose.yml

# Image versions for the services this repo doesn't build (default: latest)
# WASTE_TRACKING_EXTERNAL_API_VERSION=latest
# WASTE_MOVEMENT_BACKEND_VERSION=latest
# WASTE_TRACKING_ID_BACKEND_VERSION=latest
# WASTE_ORGANISATION_BACKEND_VERSION=latest
# DWT_CLIENT_SYNC_VERSION=latest

# Maximum number of records allowed in a bulk upload request (default: 100000)
# MAX_BULK_RECORDS=100

# Comma-separated submitting organisation IDs excluded from sending audit messages to GIO and regulators
# EXCLUDED_SUBMITTING_ORGANISATION_IDS=

# API versions the external API enables (default: beta-1,beta-2)
# API_VERSIONS_ENABLED=beta-1,beta-2
